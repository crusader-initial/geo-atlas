{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["@tarojs/taro", "@types/react", "@types/react-dom"],
    "baseUrl": "."
  },
  "include": ["src"]
}
